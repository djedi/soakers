---
layout: base.njk
---
{% block posthead %}
    <!-- Preload the LCP hero image (avif; skipped by browsers without avif support) -->
    <link rel="preload" as="image" type="image/avif" fetchpriority="high" imagesrcset="{% imageSrcset "/img/gallery/storefront-clean.jpg", [480, 768, 1100, 1536] %}" imagesizes="100vw">
{% endblock %}

<section class="home-hero">
  <div class="home-hero__media">
    {% image "/img/gallery/storefront-clean.jpg", "Soakers storefront on State Street in Midvale, Utah", "100vw", [480, 768, 1100, 1536], "home-hero__img", "eager", "high" %}
  </div>
  <div class="container home-hero__inner">
    <div class="home-hero__copy">
      <p class="eyebrow eyebrow--light">Family-owned since 2011 · Midvale, Utah</p>
      <h1>Hot tubs and swim spas for Salt Lake City homes</h1>
      <p class="home-hero__lede">
        Sales, service, and honest advice from Harvey, Wendy, and family.
        Come sit in the models at our Midvale showroom — no pressure, just the right tub for your backyard.
      </p>
      <div class="home-hero__actions">
        <a href="/spa-models/" class="btn-primary">Browse spa models</a>
        <a href="tel:+18018387727" class="btn-ghost"><i class="fas fa-phone-alt" aria-hidden="true"></i>&nbsp;801-838-SPAS</a>
      </div>
    </div>
  </div>
</section>

<section class="stat-strip" aria-label="Soakers at a glance">
  <div class="container">
    <ul class="stat-strip__list">
      <li>
        <strong><i class="fas fa-star" aria-hidden="true"></i> {{ reviews.rating }}</strong>
        <span>{{ reviews.count }} Google reviews</span>
      </li>
      <li>
        <strong>2011</strong>
        <span>Family-owned since</span>
      </li>
      <li>
        <strong>A+</strong>
        <span>BBB rating</span>
      </li>
      <li>
        <strong>Mon–Sat</strong>
        <span>Showroom open 10–5</span>
      </li>
    </ul>
  </div>
</section>

<section class="home-section">
  <div class="container">
    <div class="section-title text-center">
      <span>Shop &amp; service</span>
      <h2>Everything for your backyard soak</h2>
      <p>From your first test soak to the repair call ten years later, one local family has you covered.</p>
    </div>

    <div class="category-grid">
      <a href="/spa-models/" class="category-card">
        {% image "/img/gallery/pergola-install.jpg", "", "(max-width: 767px) 100vw, (max-width: 1199px) 50vw, 270px", [360, 540, 720], "category-card__img" %}
        <span class="category-card__body">
          <span class="category-card__title">Hot tubs</span>
          <span class="category-card__text">Artesian, Nordic, Island, South Seas and Garden Spas — 110V plug-and-play to 8-seat flagships.</span>
          <span class="category-card__link">See hot tubs <i class="fas fa-chevron-right" aria-hidden="true"></i></span>
        </span>
      </a>
      <a href="/spa-models/swim-spas/" class="category-card category-card--product">
        {% image "/img/spa-models/swim-spas/DT-19-500X500-2.jpg", "", "(max-width: 767px) 100vw, (max-width: 1199px) 50vw, 270px", [360, 540, 720], "category-card__img" %}
        <span class="category-card__body">
          <span class="category-card__title">Swim spas</span>
          <span class="category-card__text">TidalFit swim spas: swim, train, and soak year-round without a pool.</span>
          <span class="category-card__link">See swim spas <i class="fas fa-chevron-right" aria-hidden="true"></i></span>
        </span>
      </a>
      <a href="/covers/" class="category-card">
        {% image "/img/gallery/mountain-view.jpg", "", "(max-width: 767px) 100vw, (max-width: 1199px) 50vw, 270px", [360, 540, 720], "category-card__img" %}
        <span class="category-card__body">
          <span class="category-card__title">Covers &amp; lifters</span>
          <span class="category-card__text">Replacement covers, cover lifters, and Covana automated covers that open at the turn of a key.</span>
          <span class="category-card__link">See covers <i class="fas fa-chevron-right" aria-hidden="true"></i></span>
        </span>
      </a>
      <a href="/services/" class="category-card">
        {% image "/img/gallery/storefront1.jpg", "", "(max-width: 767px) 100vw, (max-width: 1199px) 50vw, 270px", [360, 540, 720], "category-card__img" %}
        <span class="category-card__body">
          <span class="category-card__title">Service &amp; repair</span>
          <span class="category-card__text">We fix what we sell — and hot tubs we didn't. Repairs, maintenance, and parts.</span>
          <span class="category-card__link">See services <i class="fas fa-chevron-right" aria-hidden="true"></i></span>
        </span>
      </a>
    </div>
  </div>
</section>

<section class="home-section home-section--muted">
  <div class="container">
    <div class="split">
      <div class="split__copy">
        <p class="eyebrow">Why choose us</p>
        <h2>Your neighborhood hot tub experts</h2>
        <p class="split__lede">
          Family-owned and operated in Midvale. We don't just sell hot tubs — we deliver them, set them up, and keep them running.
        </p>
        <div class="brand-list" aria-label="Authorized brands">
          <a href="/spa-models/island-spas/">Artesian Spas</a>
          <a href="/spa-models/nordic-luxury/">Nordic Hot Tubs</a>
          <a href="/spa-models/swim-spas/">TidalFit</a>
          <a href="/spa-models/south-seas-spas/">South Seas</a>
          <a href="/spa-models/garden-spas/">Garden Spas</a>
          <a href="/covana/">Covana</a>
        </div>
      </div>
      <div class="feature-grid">
        <div class="feature-card">
          <i class="fas fa-users" aria-hidden="true"></i>
          <h3>Family owned</h3>
          <p>Harvey, Wendy, and family have been helping Utahns find their perfect spa since 2011.</p>
        </div>
        <div class="feature-card">
          <i class="fas fa-wrench" aria-hidden="true"></i>
          <h3>Sales &amp; service</h3>
          <p>We service what we sell — and hot tubs we didn't. <a href="/services/">Repairs, maintenance, and parts</a>.</p>
        </div>
        <div class="feature-card">
          <i class="fas fa-star" aria-hidden="true"></i>
          <h3>{{ reviews.rating }} on Google</h3>
          <p>{{ reviews.count }} reviews and counting. Read what our customers say below.</p>
        </div>
        <div class="feature-card">
          <i class="fas fa-dollar-sign" aria-hidden="true"></i>
          <h3>Financing available</h3>
          <p>Affordable monthly payments through Mountain America Credit Union. <a href="/financing/">Apply in-store or online</a>.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="home-section home-section--dark">
  <div class="container">
    <div class="section-title section-title--light text-center">
      <span>How it works</span>
      <h2>From test soak to first soak</h2>
    </div>
    <ol class="steps">
      <li class="steps__item">
        <i class="fas fa-bath" aria-hidden="true"></i>
        <h3>Try them out</h3>
        <p>Visit the Midvale showroom and sit in the models. Bring a swimsuit if you want a wet test.</p>
      </li>
      <li class="steps__item">
        <i class="fas fa-handshake" aria-hidden="true"></i>
        <h3>Pick your fit</h3>
        <p>We'll talk seating, jets, power, and budget — then help with <a href="/financing/">financing</a> if you need it.</p>
      </li>
      <li class="steps__item">
        <i class="fas fa-truck" aria-hidden="true"></i>
        <h3>Delivery &amp; setup</h3>
        <p>We deliver, place, and start up your spa, and walk you through water care.</p>
      </li>
      <li class="steps__item">
        <i class="fas fa-wrench" aria-hidden="true"></i>
        <h3>Service for life</h3>
        <p>Chemicals, parts, and repairs from the same local family that sold it to you.</p>
      </li>
    </ol>
  </div>
</section>

<section class="home-section">
  <div class="container">
    <div class="section-title text-center">
      <span>Gallery</span>
      <h2>Our showroom &amp; installations</h2>
      <p>See our store and some of the beautiful hot tub installations by our customers.</p>
    </div>

    <div class="bento">
      <div class="gallery-view bento__item bento__item--wide">
        <a href="/img/gallery/deck-install.jpg">
          {% image "/img/gallery/deck-install.jpg", "Hot tub built into deck", "(max-width: 767px) 100vw, (max-width: 1199px) 64vw, 740px", [480, 740, 1100], "gallery-img" %}
        </a>
      </div>
      <div class="gallery-view bento__item">
        <a href="/img/gallery/store-interior.jpg">
          {% image "/img/gallery/store-interior.jpg", "Inside the Soakers showroom", "(max-width: 767px) 100vw, (max-width: 1199px) 31vw, 360px", [360, 540, 720], "gallery-img" %}
        </a>
      </div>
      <div class="gallery-view bento__item">
        <a href="/img/gallery/nordic-snow.jpg">
          {% image "/img/gallery/nordic-snow.jpg", "Nordic hot tub in the snow", "(max-width: 767px) 100vw, (max-width: 1199px) 31vw, 360px", [360, 540, 720], "gallery-img" %}
        </a>
      </div>
      <div class="gallery-view bento__item">
        <a href="/img/gallery/umbrella-spa.jpg">
          {% image "/img/gallery/umbrella-spa.jpg", "Hot tub with umbrella accessory", "(max-width: 767px) 100vw, (max-width: 1199px) 31vw, 360px", [360, 540, 720], "gallery-img" %}
        </a>
      </div>
      <div class="gallery-view bento__item">
        <a href="/img/gallery/stone-surround.jpg">
          {% image "/img/gallery/stone-surround.jpg", "Hot tub with stone surround on deck", "(max-width: 767px) 100vw, (max-width: 1199px) 31vw, 360px", [360, 540, 720], "gallery-img" %}
        </a>
      </div>
      <div class="gallery-view bento__item bento__item--wide">
        <a href="/img/gallery/gazebo-spa.jpg">
          {% image "/img/gallery/gazebo-spa.jpg", "Hot tub under wooden gazebo", "(max-width: 767px) 100vw, (max-width: 1199px) 64vw, 740px", [480, 740, 1100], "gallery-img" %}
        </a>
      </div>
      <div class="gallery-view bento__item">
        <a href="/img/gallery/storefront-clean.jpg">
          {% image "/img/gallery/storefront-clean.jpg", "Soakers storefront in Midvale, Utah", "(max-width: 767px) 100vw, (max-width: 1199px) 31vw, 360px", [360, 540, 720], "gallery-img" %}
        </a>
      </div>
    </div>
  </div>
</section>

{% include "testimonials.njk" %}

<section class="site-cta">
  <div class="container">
    <h2>Ready to find your perfect hot tub?</h2>
    <p>
      Visit our showroom in Midvale or give us a call. No pressure — just friendly, honest advice from people who love what they do.
    </p>
    <div class="site-cta__actions">
      <a href="tel:+18018387727" class="btn-on-accent">Call 801-838-SPAS</a>
      <a href="/contact/" class="btn-on-accent-ghost">Get directions</a>
    </div>
  </div>
</section>

{% include "map-embed.njk" %}
