---
layout: base.njk
---
{% block posthead %}
    <!-- Preload the LCP hero image (avif; skipped by browsers without avif support) -->
    <link rel="preload" as="image" type="image/avif" imagesrcset="/img/optimized/storefront-480w.avif 480w, /img/optimized/storefront-720w.avif 720w, /img/optimized/storefront-1100w.avif 1100w, /img/optimized/storefront-1600w.avif 1600w" imagesizes="(max-width: 900px) 100vw, 56vw">
{% endblock %}

<section class="home-hero">
  <div class="home-hero__inner">
    <div class="home-hero__copy">
      <p class="eyebrow">Family-owned · Midvale, Utah</p>
      <h1>Hot tubs and swim spas for Utah homes</h1>
      <p class="home-hero__lede">
        Sales, service, and honest advice from Harvey, Wendy, and family.
        Come sit in the models — no pressure, just the right tub for your backyard.
      </p>
      <div class="home-hero__actions">
        <a href="/spa-models/" class="btn-primary">Browse spa models</a>
        <a href="tel:+18018387727" class="btn-ghost">Call 801-838-SPAS</a>
      </div>
      <p class="home-hero__trust">
        <span><i class="fas fa-star" aria-hidden="true"></i> 4.8 on Google</span>
        <span><i class="fas fa-shield-alt" aria-hidden="true"></i> BBB-accredited</span>
        <span><i class="fas fa-clock" aria-hidden="true"></i> Open Mon–Sat, 10–5</span>
      </p>
    </div>
    <div class="home-hero__media">
      {% image "/img/gallery/storefront.jpg", "Soakers storefront in Midvale, Utah with the Wasatch mountains behind the shop", "(max-width: 900px) 100vw, 56vw", [480, 720, 1100, 1600], "home-hero__img", "eager", "high" %}
      <div class="home-hero__badge">
        <i class="fas fa-star" aria-hidden="true"></i>
        <div>
          <strong>4.8 out of 5</strong>
          <small>94 Google reviews</small>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="upgrade-section">
  <div class="container">
    <div class="scetion-title text-center mb-50">
      <span>Why Choose Us</span>
      <h2>Your neighborhood hot tub experts</h2>
      <p>
        Family-owned and operated in Midvale. We don't just sell hot tubs — we service them too.
      </p>
    </div>

    <div class="row">
      <div class="col-lg-3 col-md-6 mb-4">
        <div class="feature-card">
          <i class="fas fa-users" aria-hidden="true"></i>
          <h3>Family owned</h3>
          <p>Harvey, Wendy, and family have been helping Utahns find their perfect spa for years.</p>
        </div>
      </div>
      <div class="col-lg-3 col-md-6 mb-4">
        <div class="feature-card">
          <i class="fas fa-wrench" aria-hidden="true"></i>
          <h3>Sales &amp; service</h3>
          <p>We service what we sell — and hot tubs we didn't sell. <a href="/services/">Repairs, maintenance, and parts</a>.</p>
        </div>
      </div>
      <div class="col-lg-3 col-md-6 mb-4">
        <div class="feature-card">
          <i class="fas fa-star" aria-hidden="true"></i>
          <h3>4.8 on Google</h3>
          <p>94 reviews and counting. Our customers love us — read what they have to say below.</p>
        </div>
      </div>
      <div class="col-lg-3 col-md-6 mb-4">
        <div class="feature-card">
          <i class="fas fa-dollar-sign" aria-hidden="true"></i>
          <h3>Financing available</h3>
          <p>Affordable monthly payments through Mountain America Credit Union. <a href="/financing/">Apply in-store or online</a>.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="upgrade-section upgrade-section--muted">
  <div class="container">
    <div class="scetion-title text-center mb-4">
      <span>Our Brands</span>
      <h2>Authorized dealer</h2>
    </div>
    <div class="brand-grid">
      <a href="/spa-models/island-spas/" class="brand-chip">Artesian Spas</a>
      <a href="/spa-models/nordic-luxury/" class="brand-chip">Nordic Hot Tubs</a>
      <a href="/spa-models/swim-spas/" class="brand-chip">TidalFit Swim Spas</a>
      <a href="/spa-models/south-seas-spas/" class="brand-chip">South Seas Spas</a>
      <a href="/spa-models/garden-spas/" class="brand-chip">Garden Spas</a>
      <a href="/covana/" class="brand-chip">Covana Gazebos</a>
    </div>
  </div>
</section>

<section class="upgrade-section">
  <div class="container">
    <div class="scetion-title text-center mb-50">
      <span>Gallery</span>
      <h2>Our showroom &amp; installations</h2>
      <p>
        See our store and some of the beautiful hot tub installations by our customers.
      </p>
    </div>

    <div class="row">
      <div class="col-lg-4 col-md-6 mb-4">
        <div class="gallery-view">
          <a href="/img/gallery/storefront.jpg">
            {% image "/img/gallery/storefront.jpg", "Soakers storefront in Midvale, Utah", "(max-width: 768px) 100vw, 33vw", [400, 800], "img-fluid rounded shadow-sm gallery-img" %}
          </a>
        </div>
      </div>
      <div class="col-lg-4 col-md-6 mb-4">
        <div class="gallery-view">
          <a href="/img/gallery/store-interior.jpg">
            {% image "/img/gallery/store-interior.jpg", "Inside the Soakers showroom", "(max-width: 768px) 100vw, 33vw", [400, 800], "img-fluid rounded shadow-sm gallery-img" %}
          </a>
        </div>
      </div>
      <div class="col-lg-4 col-md-6 mb-4">
        <div class="gallery-view">
          <a href="/img/gallery/nordic-snow.jpg">
            {% image "/img/gallery/nordic-snow.jpg", "Nordic hot tub in the snow", "(max-width: 768px) 100vw, 33vw", [400, 800], "img-fluid rounded shadow-sm gallery-img" %}
          </a>
        </div>
      </div>
      <div class="col-lg-4 col-md-6 mb-4">
        <div class="gallery-view">
          <a href="/img/gallery/mountain-view.jpg">
            {% image "/img/gallery/mountain-view.jpg", "Hot tub with mountain view", "(max-width: 768px) 100vw, 33vw", [400, 800], "img-fluid rounded shadow-sm gallery-img" %}
          </a>
        </div>
      </div>
      <div class="col-lg-4 col-md-6 mb-4">
        <div class="gallery-view">
          <a href="/img/gallery/umbrella-spa.jpg">
            {% image "/img/gallery/umbrella-spa.jpg", "Hot tub with umbrella accessory", "(max-width: 768px) 100vw, 33vw", [400, 800], "img-fluid rounded shadow-sm gallery-img" %}
          </a>
        </div>
      </div>
      <div class="col-lg-4 col-md-6 mb-4">
        <div class="gallery-view">
          <a href="/img/gallery/pergola-install.jpg">
            {% image "/img/gallery/pergola-install.jpg", "Hot tub under pergola", "(max-width: 768px) 100vw, 33vw", [400, 800], "img-fluid rounded shadow-sm gallery-img" %}
          </a>
        </div>
      </div>
      <div class="col-lg-4 col-md-6 mb-4">
        <div class="gallery-view">
          <a href="/img/gallery/deck-install.jpg">
            {% image "/img/gallery/deck-install.jpg", "Hot tub built into deck", "(max-width: 768px) 100vw, 33vw", [400, 800], "img-fluid rounded shadow-sm gallery-img" %}
          </a>
        </div>
      </div>
      <div class="col-lg-4 col-md-6 mb-4">
        <div class="gallery-view">
          <a href="/img/gallery/stone-surround.jpg">
            {% image "/img/gallery/stone-surround.jpg", "Hot tub with stone surround on deck", "(max-width: 768px) 100vw, 33vw", [400, 800], "img-fluid rounded shadow-sm gallery-img" %}
          </a>
        </div>
      </div>
      <div class="col-lg-4 col-md-6 mb-4">
        <div class="gallery-view">
          <a href="/img/gallery/gazebo-spa.jpg">
            {% image "/img/gallery/gazebo-spa.jpg", "Hot tub under wooden gazebo", "(max-width: 768px) 100vw, 33vw", [400, 800], "img-fluid rounded shadow-sm gallery-img" %}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{% include "testimonials.njk" %}

<section class="site-cta">
  <div class="container">
    <h2>Ready to find your perfect hot tub?</h2>
    <p>
      Visit our showroom in Midvale or give us a call. No pressure — just friendly, honest advice from people who love what they do.
    </p>
    <div class="site-cta__actions">
      <a href="tel:+18018387727" class="btn-on-accent">Call 801-838-SPAS</a>
      <a href="/contact/" class="btn-on-accent-ghost">Get directions</a>
    </div>
  </div>
</section>

{% include "map-embed.njk" %}
