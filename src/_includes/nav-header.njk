<!-- Start Site Header -->
<header class="site-header">
  <!-- Top utility bar -->
  <div class="topbar">
    <div class="container">
      <div class="topbar__left">
        <span class="topbar__item topbar__item--hours">
          <i class="fas fa-clock" aria-hidden="true"></i>
          Mon–Sat: 10 AM – 5 PM
        </span>
        <a
          class="topbar__item topbar__item--address"
          href="https://www.google.com/maps/place/Soakers/@40.6253922,-111.89205,17z/data=!3m1!4b1!4m5!3m4!1s0x875289b056796419:0xf788862c01f371e2!8m2!3d40.6253922!4d-111.8898613"
          target="_blank"
          rel="noopener noreferrer"
        >
          <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
          6905 S State St, Midvale, UT 84047
        </a>
      </div>
      <div class="topbar__right">
        <a class="topbar__item" href="tel:+18018387727">
          <i class="fas fa-phone-alt" aria-hidden="true"></i>
          801-838-SPAS (7727)
        </a>
        <div class="topbar__socials">
          <a href="https://www.facebook.com/Soakers-210242449012689" target="_blank" rel="noopener noreferrer" aria-label="Soakers on Facebook">
            <i class="fab fa-facebook-f" aria-hidden="true"></i>
          </a>
          <a href="https://www.google.com/maps/place/Soakers/@40.6253922,-111.8898613,16z" target="_blank" rel="noopener noreferrer" aria-label="Soakers on Google Maps">
            <i class="fab fa-google" aria-hidden="true"></i>
          </a>
          <a href="https://www.yelp.com/biz/soakers-midvale" target="_blank" rel="noopener noreferrer" aria-label="Soakers on Yelp">
            <i class="fab fa-yelp" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Main navigation -->
  <nav class="navbar navbar-expand-lg site-nav" aria-label="Main navigation">
    <div class="container">
      <a class="navbar-brand" href="/">
        <img src="/img/logo.png" alt="Soakers — hot tubs and swim spas in Midvale, Utah" loading="eager" fetchpriority="high" width="143" height="50" />
      </a>

      <button
        class="navbar-toggler"
        type="button"
        data-toggle="collapse"
        data-target="#siteNav"
        aria-controls="siteNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="siteNav">
        <ul class="navbar-nav ml-auto">
          {%- for ni in nav.pages %}
          {%- if ni.pages %}
          <li class="nav-item dropdown{% if page.url and ni.href != '/' and page.url.indexOf(ni.href) === 0 %} active{% endif %}">
            <a class="nav-link dropdown-toggle" href="{{ ni.href }}" id="nav-drop-{{ loop.index }}" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
              {{ ni.name }}
            </a>
            <div class="dropdown-menu" aria-labelledby="nav-drop-{{ loop.index }}">
              {%- for l2 in ni.pages %}
              <a class="dropdown-item" href="{{ l2.href }}">{{ l2.name }}</a>
              {%- endfor %}
            </div>
          </li>
          {%- else %}
          <li class="nav-item{% if page.url and ni.href == page.url %} active{% endif %}">
            <a class="nav-link" href="{{ ni.href }}"{% if ni.newTab %} target="_blank" rel="noopener noreferrer"{% endif %}>
              {{ ni.name }}
            </a>
          </li>
          {%- endif %}
          {%- endfor %}
          <li class="nav-item nav-cta">
            <a class="btn btn-primary" href="tel:+18018387727">
              <i class="fas fa-phone-alt" aria-hidden="true"></i>
              Call 801-838-SPAS
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>
<!-- End Site Header -->
