<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Required Meta Tags -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Preload heading font (self-hosted, latin only) -->
    <link rel="preload" href="/fonts/josefin-sans-latin-700.woff2" as="font" type="font/woff2" crossorigin>

    <!-- Vendor CSS (Bootstrap, purged at build) -->
    <link rel="stylesheet" href="/css/vendor.css?v={% assetHash '/css/vendor.css' %}" />
    <!-- Site CSS (custom styles + responsive) -->
    <link rel="stylesheet" href="/css/style.css?v={% assetHash '/css/style.css' %}" />
    <!-- Font Awesome (subset — icons used on the site only) -->
    <link rel="stylesheet" href="/fonts/fontawesome-subset.css?v={% assetHash '/fonts/fontawesome-subset.css' %}" />

    <!-- Title (output once so Nunjucks does not double-escape &) -->
    {%- if title -%}
    <title>{{ title }} | {{ meta.siteName }}</title>
    {%- else -%}
    <title>{{ meta.siteName }}</title>
    {%- endif -%}
    <meta name="description" content="{{ description or meta.siteDescription }}" />
    {% if robots %}
    <meta name="robots" content="{{ robots }}" />
    {% endif %}

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="57x57" href="/favicon/apple-icon-57x57.png">
    <link rel="apple-touch-icon" sizes="60x60" href="/favicon/apple-icon-60x60.png">
    <link rel="apple-touch-icon" sizes="72x72" href="/favicon/apple-icon-72x72.png">
    <link rel="apple-touch-icon" sizes="76x76" href="/favicon/apple-icon-76x76.png">
    <link rel="apple-touch-icon" sizes="114x114" href="/favicon/apple-icon-114x114.png">
    <link rel="apple-touch-icon" sizes="120x120" href="/favicon/apple-icon-120x120.png">
    <link rel="apple-touch-icon" sizes="144x144" href="/favicon/apple-icon-144x144.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/favicon/apple-icon-152x152.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-icon-180x180.png">
    <link rel="icon" type="image/png" sizes="192x192"  href="/favicon/android-icon-192x192.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
    <link rel="manifest" href="/favicon/manifest.json">
    <meta name="msapplication-TileColor" content="#0e2430">
    <meta name="msapplication-TileImage" content="/favicon/ms-icon-144x144.png">
    <meta name="theme-color" content="#0e2430">

    {%- if page.url != '/404.html' and (not robots or 'noindex' not in robots) -%}
    <!-- Canonical URL -->
    <link rel="canonical" href="{{ meta.url }}{{ page.url }}" />
    {%- endif %}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="{{ meta.siteName }}" />
    {%- if title %}
    <meta property="og:title" content="{{ title }} | {{ meta.siteName }}" />
    {%- else %}
    <meta property="og:title" content="{{ meta.siteName }}" />
    {%- endif %}
    <meta property="og:description" content="{{ description or meta.siteDescription }}" />
    <meta property="og:url" content="{{ meta.url }}{{ page.url }}" />
    {%- set socialImg %}{% if pageSocialImg %}{{ pageSocialImg }}{% else %}/img/og.png{% endif %}{% endset -%}
    <meta property="og:image" content="{{ meta.url }}{{ socialImg }}" />
    <meta property="og:image:alt" content="{{ title or meta.siteName }} — hot tub dealer in Midvale, Utah" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    {% if meta.twitterUsername %}
      <meta name="twitter:site" content="@{{ meta.twitterUsername }}" />
      <meta name="twitter:creator" content="@{{ meta.twitterUsername }}" />
    {% endif %}
    {%- if title %}
    <meta name="twitter:title" content="{{ title }} | {{ meta.siteName }}" />
    {%- else %}
    <meta name="twitter:title" content="{{ meta.siteName }}" />
    {%- endif %}
    <meta name="twitter:description" content="{{ description or meta.siteDescription }}" />
    <meta name="twitter:image" content="{{ meta.url }}{{ socialImg }}" />
    <meta name="twitter:image:alt" content="{{ title or meta.siteName }} — hot tub dealer in Midvale, Utah" />

{% block posthead %}{% endblock %}

    <!-- LocalBusiness + WebSite Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "HotTubStore",
          "@id": "{{ meta.url }}/#business",
          "name": "Soakers",
          "url": "{{ meta.url }}",
          "logo": "{{ meta.url }}/img/logo.png",
          "image": "{{ meta.url }}/img/og.png",
          "description": "Family-owned hot tub dealer in Midvale, UT. Authorized dealer for Artesian Spas, Nordic Hot Tubs, TidalFit Swim Spas, Covana, and more. Sales and service.",
          "telephone": "+1-801-838-7727",
          "email": "service@soakers.biz",
          "priceRange": "$$",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "6905 S State St, Suite A",
            "addressLocality": "Midvale",
            "addressRegion": "UT",
            "postalCode": "84047",
            "addressCountry": "US"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 40.6253922,
            "longitude": -111.8898613
          },
          "hasMap": "https://www.google.com/maps/place/Soakers/@40.6253922,-111.8898613,16z",
          "openingHours": "Mo-Sa 10:00-17:00",
          "openingHoursSpecification": [
            {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
              "opens": "10:00",
              "closes": "17:00"
            }
          ],
          "areaServed": [
            { "@type": "City", "name": "Midvale" },
            { "@type": "City", "name": "Salt Lake City" },
            { "@type": "City", "name": "Sandy" },
            { "@type": "City", "name": "Murray" },
            { "@type": "City", "name": "West Jordan" },
            { "@type": "City", "name": "South Jordan" },
            { "@type": "City", "name": "Draper" },
            { "@type": "AdministrativeArea", "name": "Salt Lake County" },
            { "@type": "State", "name": "Utah" }
          ],
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "4.8",
            "reviewCount": "94",
            "bestRating": "5",
            "worstRating": "1"
          },
          "sameAs": [
            "https://www.facebook.com/Soakers-210242449012689",
            "https://www.google.com/maps/place/Soakers/@40.6253922,-111.8898613,16z",
            "https://www.yelp.com/biz/soakers-midvale",
            "https://www.bbb.org/us/ut/midvale/profile/hot-tubs-and-spas/soakers-llc-1166-90025172"
          ],
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Hot Tubs & Swim Spas",
            "itemListElement": [
              { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Artesian Spas" } },
              { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Nordic Hot Tubs" } },
              { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Island Spas" } },
              { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Garden Spas" } },
              { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "South Seas Spas" } },
              { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "TidalFit Swim Spas" } },
              { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Covana Automated Covers" } }
            ]
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://soakers.biz/#website",
          "url": "https://soakers.biz",
          "name": "Soakers",
          "description": "Family-owned hot tub and swim spa dealer in Midvale, Utah.",
          "publisher": { "@id": "https://soakers.biz/#business" },
          "inLanguage": "en-US"
        }
      ]
    }
    </script>
  </head>
  <body>

    <a href="#main-content" class="skip-link">Skip to main content</a>

    {% include 'nav-header.njk' %}

    <main id="main-content">
    {% if page.url != '/' and page.url != '/404.html' and not hideBreadcrumbs %}
      {% include 'breadcrumbs.njk' %}
    {% endif %}
    {% block content %}
    {{ content | safe }}
    {% endblock %}
    </main>

    <!-- Footer -->
    {% block footer %}
    <footer class="footer">
      <div class="container">
        <div class="row">
          <div class="col-lg-4 col-md-6 mb-4">
            <div class="footer__brand">
              <a href="/" aria-label="Soakers home">
                <img src="/img/logo.png" srcset="/img/logo-2x.png 2x" alt="Soakers — hot tubs and swim spas in Midvale, Utah" width="143" height="50" loading="lazy" />
              </a>
              <p>
                Family-owned hot tub dealer in Midvale, Utah. Sales, service, and financing for Artesian, Nordic, TidalFit, and Covana.
              </p>
              <div class="footer__socials">
                <a href="https://www.facebook.com/Soakers-210242449012689" target="_blank" rel="noopener noreferrer" aria-label="Soakers on Facebook">
                  <i class="fab fa-facebook-f" aria-hidden="true"></i>
                </a>
                <a href="https://www.google.com/maps/place/Soakers/@40.6253922,-111.8898613,16z" target="_blank" rel="noopener noreferrer" aria-label="Soakers on Google Maps">
                  <i class="fab fa-google" aria-hidden="true"></i>
                </a>
                <a href="https://www.yelp.com/biz/soakers-midvale" target="_blank" rel="noopener noreferrer" aria-label="Soakers on Yelp">
                  <i class="fab fa-yelp" aria-hidden="true"></i>
                </a>
                <a href="https://www.bbb.org/us/ut/midvale/profile/hot-tubs-and-spas/soakers-llc-1166-90025172" target="_blank" rel="noopener noreferrer" aria-label="Soakers BBB Business Review">
                  BBB
                </a>
              </div>
            </div>
          </div>

          <div class="col-lg-2 col-md-6 mb-4">
            <h3 class="footer__heading">Explore</h3>
            <ul class="footer__list">
              <li><a href="/spa-models/">Spa Models</a></li>
              <li><a href="/services/">Services</a></li>
              <li><a href="/financing/">Financing</a></li>
              <li><a href="/faq/">FAQ</a></li>
              <li><a href="/about/">About Us</a></li>
              <li><a href="/contact/">Contact Us</a></li>
            </ul>
          </div>

          <div class="col-lg-3 col-md-6 mb-4">
            <h3 class="footer__heading">Popular Lines</h3>
            <ul class="footer__list">
              <li><a href="/spa-models/island-spas/">Island Spas</a></li>
              <li><a href="/spa-models/artesian-elite/">Artesian Elite</a></li>
              <li><a href="/spa-models/nordic-luxury/">Nordic Hot Tubs</a></li>
              <li><a href="/spa-models/swim-spas/">TidalFit Swim Spas</a></li>
              <li><a href="/spa-models/south-seas-spas/">South Seas Spas</a></li>
              <li><a href="/covana/">Covana Gazebos</a></li>
            </ul>
          </div>

          <div class="col-lg-3 col-md-6 mb-4">
            <h3 class="footer__heading">Contact</h3>
            <ul class="footer__list">
              <li>
                <a href="tel:+18018387727"><i class="fas fa-mobile-alt" aria-hidden="true"></i> 801-838-SPAS (7727)</a>
              </li>
              <li>
                <a href="mailto:service@soakers.biz"><i class="far fa-envelope" aria-hidden="true"></i> service@soakers.biz</a>
              </li>
              <li>
                <i class="fas fa-map-marker-alt" aria-hidden="true"></i> 6905 S State St, Suite A<br>
                Midvale, UT 84047
              </li>
              <li>
                <i class="fas fa-clock" aria-hidden="true"></i> Mon–Sat: 10 AM – 5 PM
              </li>
            </ul>
            <p class="footer__hours">
              <a href="https://www.google.com/maps/place/Soakers/@40.6253922,-111.8898613,16z" target="_blank" rel="noopener noreferrer">Get directions →</a>
            </p>
          </div>
        </div>
      </div>

      <div class="footer__bottom">
        <div class="container">
          <p>Copyright &copy; {% year %} Soakers, LLC. All Rights Reserved.</p>
          <div class="footer__legal">
            <a href="/privacy-policy/">Privacy Policy</a>
            <a href="/terms-and-conditions/">Terms &amp; Conditions</a>
          </div>
        </div>
      </div>
    </footer>
    {% endblock %}
    <!-- Footer End -->

    <!-- Custom JS (dependency-free) -->
    <script src="/js/custom.js?v={% assetHash '/js/custom.js' %}" defer></script>

    <!-- Clicky Analytics -->
    <script async data-id="101502556" src="//static.getclicky.com/js"></script>
    <!-- End Clicky Analytics -->

    <!-- Mobile sticky call button -->
    <a href="tel:+18018387727" class="mobile-call-btn d-md-none" aria-label="Call Soakers at 801-838-7727">
      <i class="fas fa-phone-alt" aria-hidden="true"></i>
    </a>

    {% block postbody %}{% endblock %}
  </body>
</html>
