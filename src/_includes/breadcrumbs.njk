{#- Optional middle crumb: spa model pages get "Spa Models"; other pages can set
    `parent: { name, url }` in front matter (guides, service areas). -#}
{%- set isSpaModel = page.url != '/spa-models/' and '/spa-models/' in page.url -%}
{%- if isSpaModel -%}
{%- set crumbParent = { name: "Spa Models", url: "/spa-models/" } -%}
{%- elif parent -%}
{%- set crumbParent = parent -%}
{%- else -%}
{%- set crumbParent = false -%}
{%- endif -%}
{%- set crumbName = breadcrumb or title -%}
<nav class="seo-breadcrumbs" aria-label="Breadcrumb">
  <div class="container">
    <ol>
      <li><a href="/">Home</a></li>
      {%- if crumbParent %}
      <li><a href="{{ crumbParent.url }}">{{ crumbParent.name }}</a></li>
      {%- endif %}
      <li aria-current="page">{{ crumbName }}</li>
    </ol>
  </div>
</nav>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ meta.url }}/"
    }{% if crumbParent %},
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ crumbParent.name | tojson | safe }},
      "item": "{{ meta.url }}{{ crumbParent.url }}"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ crumbName | tojson | safe }},
      "item": "{{ meta.url }}{{ page.url }}"
    }{% else %},
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ crumbName | tojson | safe }},
      "item": "{{ meta.url }}{{ page.url }}"
    }{% endif %}
  ]
}
</script>
