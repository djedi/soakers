{%- set isSpaModel = page.url != '/spa-models/' and '/spa-models/' in page.url -%}
<nav class="seo-breadcrumbs" aria-label="Breadcrumb">
  <div class="container">
    <ol>
      <li><a href="/">Home</a></li>
      {%- if isSpaModel %}
      <li><a href="/spa-models/">Spa Models</a></li>
      {%- endif %}
      <li aria-current="page">{{ title }}</li>
    </ol>
  </div>
</nav>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ meta.url }}/"
    }{% if isSpaModel %},
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Spa Models",
      "item": "{{ meta.url }}/spa-models/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ title | tojson | safe }},
      "item": "{{ meta.url }}{{ page.url }}"
    }{% else %},
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ title | tojson | safe }},
      "item": "{{ meta.url }}{{ page.url }}"
    }{% endif %}
  ]
}
</script>
