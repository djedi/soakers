{
  "name": "11ty-netlify-jumpstart",
  "version": "0.4.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "scss": "sass src/sass:src/css",
    "css": "postcss src/css/*.css -u autoprefixer cssnano -r -m",
    "watch:eleventy": "eleventy --serve",
    "watch:sass": "sass --watch src/sass:src/css",
    "vendor": "cat src/css/bootstrap.min.css > src/css/vendor.css",
    "purge": "node scripts/purge-css.mjs",
    "start": "cross-env ELEVENTY_ENV=dev npm-run-all scss vendor --parallel watch:*",
    "build": "cross-env ELEVENTY_ENV=prod npm-run-all scss vendor --parallel build:eleventy css && npm run purge",
    "build:eleventy": "eleventy",
    "lint": "stylelint 'src/sass/**/*.scss' 'src/sass/**/**/*.scss' 'src/sass/**/**/**/*.scss'",
    "lint:fix": "stylelint --fix 'src/sass/**/*.scss' 'src/sass/**/**/*.scss' 'src/sass/**/**/**/*.scss'",
    "bump": "npm --no-git-tag-version version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/5t3ph/11ty-netlify-jumpstart.git"
  },
  "keywords": [],
  "author": "5t3ph",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/5t3ph/11ty-netlify-jumpstart/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "cssnano": "^8.0.5",
    "emoji-regex": "^10.6.0",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.1",
    "npm-run-all": "^4.1.5",
    "postcss-cli": "^11.0.1",
    "postcss-scss": "^4.0.9",
    "purgecss": "^8.0.0",
    "sass": "^1.102.0",
    "slugify": "^1.6.9",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0"
  },
  "browserslist": [
    "last 2 versions"
  ]
}
